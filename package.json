{
  "name": "forgecoach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/play.e2e.mjs",
    "e2e:draft": "node e2e/draft.e2e.mjs",
    "e2e:practice": "node e2e/practice.e2e.mjs",
    "e2e:friend": "node e2e/friend.e2e.mjs",
    "e2e:table": "node e2e/table.e2e.mjs",
    "e2e:bug": "node e2e/bug.e2e.mjs",
    "test:e2e": "node e2e/seat.e2e.mjs",
    "test:pwa": "node e2e/pwa.e2e.mjs",
    "playtest": "node --experimental-transform-types --no-warnings e2e/playtest/run.mjs",
    "bench:coach": "node bench/coach/run.mjs",
    "human-cards": "node scripts/human-cards/run.mjs",
    "human-blend": "node scripts/human-cards/run.mjs blend-test",
    "card-model": "node scripts/card-model/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
